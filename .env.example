GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/gmail/callback

DB_URL=jdbc:postgresql://localhost:5432/casiq
DB_USERNAME=casiq
DB_PASSWORD=replace-with-database-password

# Initial Flyway administrator. Generate a BCrypt hash with cost 12; never put
# the plain-text password here.
INITIAL_ADMIN_COMPANY_CODE=CASIQ
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD_HASH='$2a$12$replace-with-generated-bcrypt-hash'

# Session settings for the single Casiq application
SESSION_COOKIE_SECURE=false
SESSION_HOURS=12

# Incremental mailbox polling
EMAIL_POLLING_ENABLED=true
EMAIL_POLLING_SCHEDULER_EVERY=30s
EMAIL_POLLING_BATCH_SIZE=50
EMAIL_POLLING_LOCK_SECONDS=300
EMAIL_POLLING_INTERVAL_SECONDS=60
EMAIL_POLLING_RETRY_SECONDS=60
EMAIL_POLLING_INITIAL_LOOKBACK_HOURS=24
GMAIL_POLLING_PAGE_SIZE=100

# Conversation-to-work-item processing
CONVERSATION_WORK_ITEM_ENABLED=true
CONVERSATION_WORK_ITEM_SCHEDULER_EVERY=30s
CONVERSATION_WORK_ITEM_BATCH_SIZE=50
CONVERSATION_WORK_ITEM_LOCK_SECONDS=300
CONVERSATION_WORK_ITEM_RETRY_SECONDS=60

# Set to DEBUG for scheduler lease, worker, and provider diagnostics.
CASIQ_LOG_LEVEL=INFO
